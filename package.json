{
  "name": "@polymech/runny",
  "version": "0.2.0",
  "description": "A local GUI for running npm/pnpm/yarn scripts across your project",
  "type": "module",
  "bin": {
    "runny": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:server": "tsx watch --clear-screen=false src/cli.ts",
    "dev:client": "rspack dev --mode development",
    "dev": "concurrently -k --kill-signal SIGKILL -n server,client -c blue,magenta \"tsx watch --clear-screen=false src/cli.ts\" \"node ./scripts/wait-and-rspack.mjs\"",
    "build:client": "rspack build --mode production",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "test": "tsx --test src/shared/group-scripts.test.ts src/client/lib/fuzzy-search.test.ts src/server/services/discovery.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "open": "^11.0.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.1.10",
    "@rspack/core": "^2.1.10",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "css-loader": "^7.1.4",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zustand": "^5.0.15"
  },
  "author": "Sam Kavanagh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polymech-info/runny"
  },
  "keywords": [
    "npm",
    "scripts",
    "gui",
    "monorepo",
    "pnpm",
    "yarn",
    "runner",
    "dashboard",
    "soft-ci"
  ]
}
